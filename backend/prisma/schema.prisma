generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // "ADMIN", "PROJECT_LEADER", "MEMBER"
  description String?
  createdAt   DateTime @default(now())

  users       User[]

  @@map("roles")
}

model User {
  id                 String        @id @default(uuid())
  name               String
  email              String        @unique
  password           String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  roleId             String?
  role               Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Projects created by user
  createdProjects    Project[]     @relation("ProjectCreator")

  // Projects assigned to user
  assignedProjects   Project[]     @relation("ProjectAssignee")

  // Tasks created by user
  createdTasks       Task[]        @relation("TaskCreator")

  // Tasks assigned to user
  assignedTasks      Task[]        @relation("TaskAssignee")

  // Activities performed by user
  authoredActivities ActivityLog[] @relation("ActivityAuthor")

  // Activities targeted at user (e.g. assigned updates)
  targetedActivities ActivityLog[] @relation("ActivityTarget")

  @@map("users")
}

model Project {
  id           String        @id @default(uuid())
  name         String
  description  String        @db.Text
  status       String        @default("Not Started") // "Not Started", "In Progress", "Completed"
  startDate    String        // YYYY-MM-DD
  endDate      String        // YYYY-MM-DD
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  userId       String        // Creator/Leader of the project
  user         User          @relation("ProjectCreator", fields: [userId], references: [id], onDelete: Cascade)

  assignedToId String?       // Assigned member or lead
  assignedTo   User?         @relation("ProjectAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  tasks        Task[]
  activityLogs ActivityLog[]

  @@map("projects")
}

model Task {
  id           String        @id @default(uuid())
  name         String
  description  String        @db.Text
  priority     String        @default("Medium") // "Low", "Medium", "High"
  status       String        @default("Pending") // "Pending", "In Progress", "Completed"
  dueDate      String        // YYYY-MM-DD
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  creatorId    String?       // Who created the task
  creator      User?         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  assignedToId String?       // Assigned member
  assignedTo   User?         @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

model ActivityLog {
  id           String   @id @default(uuid())
  action       String   // "CREATED", "UPDATED_STATUS", "ASSIGNED", "DELETED"
  message      String   // e.g. "Task 'Integrate Stripe' marked as Completed"
  entityType   String   // "PROJECT" or "TASK"
  entityId     String
  entityName   String

  userId       String   // User who performed the action
  user         User     @relation("ActivityAuthor", fields: [userId], references: [id], onDelete: Cascade)

  targetUserId String?  // Assigned user receiving the update
  targetUser   User?    @relation("ActivityTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@map("activity_logs")
}
